@{
    ViewData["Title"] = "Sign In";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center py-5 px-3" style="background: linear-gradient(135deg, #0b132b 0%, #1e3a8a 100%);">
    <div class="portal-card shadow-lg border-0" style="max-width: 420px; width: 100%; border-radius: 16px;">
        <div class="p-4 p-sm-5">
            <div class="text-center mb-4">
                <div class="brand-logo mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.35rem; border-radius: 12px;">
                    S
                </div>
                <h4 class="fw-bold mb-1">BTEC SIMS Portal</h4>
                <p class="text-muted small mb-0">Sign in with your university account to continue</p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger py-2 small mb-3" role="alert">
                    @TempData["ErrorMessage"]
                </div>
            }

            <form asp-controller="Auth" asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">University Email or ID</label>
                    <input type="text" name="email" class="form-control" placeholder="name@btec.edu.vn or Student ID" required autofocus />
                </div>
                <div class="mb-4">
                    <label class="form-label small fw-semibold text-secondary">Password</label>
                    <input type="password" name="password" class="form-control" placeholder="Enter your password" required />
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold" style="border-radius: 8px;">
                    Sign In
                </button>
            </form>
        </div>
    </div>
</div>
