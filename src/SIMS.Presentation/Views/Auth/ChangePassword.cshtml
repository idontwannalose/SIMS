@model SIMS.Domain.Entities.User
@{
    ViewData["Title"] = "Account Security & Change Password";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-1">Account Security</h4>
                <p class="text-muted small mb-0">
                    Manage your account password for <strong>@Model.GetName()</strong> (<span class="mono-id">@Model.GetId()</span>)
                </p>
            </div>
            @if (!Model.MustChangePassword)
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-light border">&larr; Dashboard</a>
            }
        </div>

        @if (Model.MustChangePassword)
        {
            <div class="alert alert-warning border-0 shadow-sm mb-4" style="border-radius:10px;">
                <strong>Action Required:</strong> You are currently signed in with the default university password. Please set a new personal password to continue using the portal.
            </div>
        }

        @if (TempData["WarningMessage"] != null && !Model.MustChangePassword)
        {
            <div class="alert alert-warning border-0 shadow-sm mb-4" style="border-radius:10px;">
                @TempData["WarningMessage"]
            </div>
        }

        <div class="portal-card">
            <div class="portal-card-header">
                <h5 class="portal-card-title">Change Password</h5>
                <span class="badge-soft @(Model.MustChangePassword ? "badge-soft-warning" : "badge-soft-success")">
                    @(Model.MustChangePassword ? "First-Login Setup" : "Active Account")
                </span>
            </div>
            <div class="portal-card-body">
                <form asp-controller="Auth" asp-action="ChangePassword" method="post" class="row g-3">
                    <div class="col-12">
                        <label class="form-label small fw-semibold text-secondary">Current Password</label>
                        <input type="password" name="currentPassword" class="form-control" placeholder="Enter your current password" required autofocus />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold text-secondary">New Password</label>
                        <input type="password" name="newPassword" class="form-control" placeholder="Enter new strong password" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold text-secondary">Confirm New Password</label>
                        <input type="password" name="confirmPassword" class="form-control" placeholder="Re-enter new password" required />
                    </div>

                    <div class="col-12">
                        <div class="p-3 rounded border small text-muted" style="background:#f9fafb;">
                            <div class="fw-semibold text-dark mb-1">Password Requirements:</div>
                            <ul class="mb-0 ps-3">
                                <li>At least 8 characters long</li>
                                <li>Contains uppercase (A–Z) and lowercase (a–z) letters</li>
                                <li>Contains at least one number (0–9) and one special symbol (e.g., <code>@@</code>, <code>#</code>, <code>$</code>, <code>!</code>)</li>
                                <li>Must not be identical to your current password</li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-12 d-flex justify-content-end gap-2 pt-2">
                        @if (!Model.MustChangePassword)
                        {
                            <a asp-controller="Home" asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                        }
                        <button type="submit" class="btn btn-primary px-4">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
